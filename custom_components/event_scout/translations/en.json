  "services": {
    "get_digest": {
      "name": "Get digest",
      "description": "Return a structured and rendered digest of upcoming events and vendor deadlines without sending a notification.",
      "fields": {
        "period": {
          "name": "Period",
          "description": "Daily or weekly digest."
        },
        "categories": {
          "name": "Categories",
          "description": "Optional list of categories to include."
        }
      }
    },
    "send_digest": {
      "name": "Send digest",
      "description": "Send a digest of upcoming events and vendor deadlines through the configured notify service.",
      "fields": {
        "period": {
          "name": "Period",
          "description": "Daily or weekly digest."
        },
        "categories": {
          "name": "Categories",
          "description": "Optional list of categories to include."
        }
      }
    },
    "send_alerts": {
      "name": "Send alerts",
      "description": "Send a notification for every current vendor deadline alert through the configured notify service."
    },
    "set_vendor_info": {
      "name": "Set vendor info",
      "description": "Manually override vendor application information for one event.",
      "fields": {
        "uid": {
          "name": "Event UID",
          "description": "The uid of the event to update."
        },
        "available": {
          "name": "Available",
          "description": "Whether a vendor application is available."
        },
        "app_open": {
          "name": "Application opens",
          "description": "The date the vendor application opens."
        },
        "app_deadline": {
          "name": "Application deadline",
          "description": "The date the vendor application closes."
        },
        "app_url": {
          "name": "Application URL",
          "description": "The URL of the vendor application."
        },
        "booth_fee_text": {
          "name": "Booth fee",
          "description": "The booth fee, as free text."
        },
        "jury_fee_text": {
          "name": "Jury fee",
          "description": "The jury fee, as free text."
